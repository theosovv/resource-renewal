# Локальная PostgreSQL из compose.yaml. Не используйте эти значения вне локальной разработки.
POSTGRES_DB=resource_renewal
POSTGRES_USER=resource_renewal
POSTGRES_PASSWORD=resource_renewal_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resource_renewal:resource_renewal_local@127.0.0.1:5432/resource_renewal?schema=public

# API и web
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
API_PROXY_TARGET=http://127.0.0.1:3000

# Server-side sessions. COOKIE_SECURE=false разрешён только для явно локального HTTP WEB_ORIGIN.
COOKIE_SECURE=false
# Только вымышленный локальный secret; для отдельного окружения сгенерируйте не менее 32 случайных байт.
CSRF_SECRET=local-only-csrf-secret-change-me-32-bytes-minimum
# Sliding idle expiry 30 минут и непродлеваемый absolute expiry 8 часов.
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# Provider и persistent worker. Lease должен быть больше provider timeout.
PROVIDER_BASE_URL=http://127.0.0.1:8091
PROVIDER_TIMEOUT_MS=5000
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
RENEWAL_RETRY_DELAY_MS=15000
RENEWAL_JOB_LEASE_MS=30000
